{
  "name": "dsh-plugin-learning-accelerator",
  "version": "0.2.2",
  "description": "A DeepSeek Harness plugin that turns Learning-Accelerator's General Learning OS into harness-native capability: the teaching protocol in the prompt, durable learner state, deterministic spaced repetition, model-callable tools, and a Web UI panel.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test tests/*.test.js"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs",
    "schemas",
    "examples"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jackson366/dsh-plugin-learning-accelerator.git"
  },
  "homepage": "https://github.com/Jackson366/dsh-plugin-learning-accelerator#readme",
  "bugs": {
    "url": "https://github.com/Jackson366/dsh-plugin-learning-accelerator/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.5",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "learning",
    "spaced-repetition"
  ],
  "license": "MIT"
}
